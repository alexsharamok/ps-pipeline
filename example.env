SkipDeployMedia=1

# Changed-files-only deploy/publish (see src/_incremental-deploy.ps1). Set to 0 to force
# full pushes; delete .p/.last-deployed.json to re-baseline (next run deploys fully).
DeployIncremental=1

SeedPushModeOverride=createOrUpdate

# Overrides the push mode of the NON-seed canvas pushes (4600-4740/4900-4910/5100),
# like SeedPushModeOverride does for seed. Empty = each stage's own default
# (locale=create; datatype/contenttype/patterns/nodes=createOrUpdate;
# category/component/composition/entry=mirror). Overriding a mirror kind to
# create/createOrUpdate stops remote deletions from propagating.
ResultPushModeOverride=

HomeDir=D:/
SIPHON_PATH_OVERRIDE=

Root=$(HomeDir)/cha
DataDir=$(Root)/data

# Git-tracked config/seed data now lives under src/ (same repo as the stage .ps1s).
# Keep DataDir for the large, untracked siphon inputs (items/media/presentation/override).
SrcDataDir=$(Root)/src/data
Result=$(Root)/result
ContentSeedDir=$(SrcDataDir)/seed-content
ContentOverrideDir=$(DataDir)/override-content

SIPHON_logFilePrefix=siphon.
SIPHON_NEXTPROJECTDIR=
# these should be also added to ref slots exclude fields (technically only ref ones should be added - but there's no harm in adding all)
SIPHON_excludeFields=eyebrowlabel|bookmarklabel|localdata|changefrequency|pagedesign|priority|partialdesigns|eventsessions|eventavailability|schemamarkup|publishedby|canonicalurl|stickynotes|flattenpaths
SIPHON_REFDEPTH=3

SkipPushCompositions=false
SIPHON_missingItemsFileName=logs/_missing-items-and-media.txt

SIPHON_UNIFORM_CANVAS_OUTPUTDIR=$(Result)/uniform-canvas
SIPHON_PRESENTATIONDIR=$(DataDir)/presentation
SIPHON_REF_SLOTS_EXCLUDE_FIELDS =gridparameters|RelatedContentType|RelatedContentTopics|ContentTypes|contenttype|topics|showcardtopic|showcarddate|titleplacement|twittercardtype|authors|eventlocation|DisplaySortOrderWhenDynamic|AuthorCard|eyebrowlabel|bookmarklabel|localdata|changefrequency|pagedesign|priority|partialdesigns|eventsessions|eventavailability|
SIPHON_REF_BLOCKS_INCLUDE_FIELDS=gridparameters|RelatedContentType|RelatedContentTopics|ContentTypes|contenttype|topics|showcardtopic|showcarddate|titleplacement|TwitterCardType|authors|eventlocation|DisplaySortOrderWhenDynamic|AuthorCard|Materials|
# Also block-deconstruct these ref fields on denormalized slot components (FeaturedCardGrid_*/RelatedContent_*)
# so they match the page-root treatment (topics -> topicsBlock). Kept narrow on purpose: the datasource
# extraction force-migrates every multi-ref field as json here, so listing more would over-convert fields
# the page root leaves as select or removes downstream (authors, eventlocation, ...).
SIPHON_REF_BLOCKS_SLOTS_INCLUDE_FIELDS=topics
SIPHON_PAGESTOEXCLUDE=*/data/*|*/403|*/404|*/pls search|*/search|*/Member Dashboard|*/Member Dashboard/*|*/LoginRedirect|*/Hospital Directory*|
SIPHON_CACHECOMPONENTS=true
SIPHON_CACHEMEDIAINDEX=true
SIPHON_EXCLUDECOMPONENTS=PlainHTMLReusable|SiteAlert|CoveoSearchResources|CoveoGlobalSearchbox|OutOfDateModal|PageTabs|MvcForm|SitecoreFormWrapper
SIPHON_CREATEREWRITES=true
SIPHON_AVOIDINTERNALLINKS=true
SIPHON_RICHTEXTMODE=html
SIPHON_HTMLFIELDTYPE=html-tinymce
SIPHON_REMOVEEMPTYFIELDS=true
SIPHON_SKIPPAGEREFERENCES=false
SIPHON_SKIPEXTRALINKFIELDS=false
SIPHON_CHILDRENREFERENCESTYPES=PromoCard
# canvas stage: emit the datasource's Sitecore children as components in a "children" slot on the matching COMPONENT
SIPHON_CHILDRENSLOTSTYPES=PhotoExhibit
SIPHON_STARTPATH=/sitecore/content/CHA/PublicWebsite/Home
SIPHON_contentRootPaths=/sitecore/content/CHA/PublicWebsite/Settings|/sitecore/login/sitecore/system/settings/feature/cha|/sitecore/content/CHA/PublicWebsite|/sitecore/system/Settings/Feature/Experience Accelerator/SiteMetadata/Enums/Twitter Card Types
SIPHON_THREADS=30
SIPHON_CACHEMODELS=true
SIPHON_CACHEASSETS=true
SIPHON_CACHEDIR=$(Root)/cache
SIPHON_INPUTDIR=$(DataDir)/items
SIPHON_MEDIAROOTDIR=$(Root)/data/media
# Only upload media referenced by content items; unreferenced media is excluded from the
# upload (verb-scoped flag for 'uniform-upload-assets' / stage 0100 -> AssetsUploader
# filters the queue via MediaReferenceService.CollectReferenceIds). Uploads are additive:
# this narrows what gets uploaded; it does not delete assets already in Uniform.
SIPHON_UNIFORM_UPLOAD_ASSETS_SKIPUNUSEDMEDIA=true
SIPHON_SKIPCLEARINGFOLDERS=false ### FALSE
SIPHON_LANGUAGES=en
SIPHON_LOGLEVEL=info
SIPHON_CONSOLELOGLEVEL=warn
SIPHON_LOGSDIR=$(Root)/logs
SIPHON_SORTLOGENTRIESBYTHREADID=true
SIPHON_dataSourceId=content
#SIPHON_VIRTUALPATH=[/]
#SIPHON_VIRTUALPATH=/Content/Public Policy/Policy Position/Investing in Kids Mental Health Now Act Introduced in the Senate


#frozen 6/12 UNIFORM_PROJECT_ID=a335c736-260d-4cdd-a7ee-a8da6f3d0191
#UNIFORM_PROJECT_ID=43f6bd56-94d6-4549-93db-f538d2deb30b
# frozen 6/12 SIPHON_UNIFORM_PROJECT_ID=a335c736-260d-4cdd-a7ee-a8da6f3d0191
#SIPHON_UNIFORM_PROJECT_ID=43f6bd56-94d6-4549-93db-f538d2deb30b
UNIFORM_PROJECT_ID=fdb06a81-7422-41bc-bcc8-5907db3b70a6
SIPHON_UNIFORM_PROJECT_ID=fdb06a81-7422-41bc-bcc8-5907db3b70a6

UNIFORM_CLI_BASE_URL=https://canary.uniform.app
SIPHON_UNIFORM_CLI_BASE_URL=https://canary.uniform.app

UNIFORM_CLI_BASE_EDGE_URL=https://canary.uniform.global

UNIFORM_API_KEY=
SIPHON_UNIFORM_API_KEY=

#old rubbish
Release.DefinitionId=42
Release.DefinitionName=CHA
Release.DeploymentID=13
Release.ReleaseName=Experiment-3
Release.AttemptNumber=77

# --- 6-tests: e2e content comparison against the prod mirror (src/6-tests/README.md) ---
SkipTests=0
TEST_PROD_URL=https://cha-prod-mirror.vercel.app
TEST_SITEMAP_URL=https://cha-prod-mirror.vercel.app/sitemap.xml
TEST_STAGE_URL=http://localhost:3000
TEST_WEBSITE_DIR=D:\cha-website
TEST_CONCURRENCY=6
TEST_PAGE_LIMIT=0
TEST_FAIL_UNDER=
TEST_VERCEL_BYPASS_SECRET=Q7hoQWzzl614P4qSyWODG3ZUT15u9IXF
TEST_EXCLUDE_PATHS=/403,/404,/search,/pls-search,/hospital-directory
# --- 6-tests comparison mode (V1 selector-map vs V2 selector-driven) — see src/6-tests/README.md ---
# Either/or per run. 0/false = V1 (manual selector-map, default). 1/true = V2 (per-page index.json CssSelectors).
# Each mode keeps its own datasets (tests/{expected,actual} vs tests/{expected-v2,actual-v2}).
TESTS_ENABLE_V2=0
# REQUIRED when TESTS_ENABLE_V2=1: root of the migration's per-page index.json tree (the presentation/<lang>
# folder). Local example: C:\cha-selectors\presentation\en (i.e. $(DataDir)\presentation\en). In CI, the server path.
TEST_SELECTOR_INDEX_ROOT=
# Optional: override the site-root ItemPath (the "…/Home" item that maps to "/"). Auto-detected when empty.
TEST_SELECTOR_ITEM_ROOT_PATH=
# Optional: re-anchor prod-derived selectors so they resolve on the stage frontend too. JSON array of {from,to};
# empty = default [{"from":"body > div:nth-of-type(2)","to":"#wrapper"}]; "[]" disables.
TEST_SELECTOR_ROOT_REBASE=
# Optional: false = also capture header/footer/GTM components. Empty/true = main-content only (matches V1 scope).
TEST_SELECTOR_BODY_ONLY=
# Component report (report-components.md): for a component present on only ONE side, trim its text to
# this many words (0 = full text). Empty = default 8.
TEST_MISSING_COMPONENT_WORDS=8