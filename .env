#SIPHON_UNIFORM_CANVAS_OUTPUTDIR=$(Result)/uniform-canvas
#SIPHON_PRESENTATIONDIR=$(DataDir)/presentation
#SIPHON_REF_SLOTS_EXCLUDE_FIELDS =gridparameters|RelatedContentType|RelatedContentTopics|ContentTypes|contenttype|topics|showcardtopic|showcarddate|titleplacement|twittercardtype|authors|eventlocation|DisplaySortOrderWhenDynamic|AuthorCard|eyebrowlabel|bookmarklabel|localdata|changefrequency|pagedesign|priority|partialdesigns|eventsessions|eventavailability|
#SIPHON_REF_BLOCKS_INCLUDE_FIELDS=gridparameters|RelatedContentType|RelatedContentTopics|ContentTypes|contenttype|topics|showcardtopic|showcarddate|titleplacement|TwitterCardType|authors|eventlocation|DisplaySortOrderWhenDynamic|AuthorCard|Materials|
# Also block-deconstruct these ref fields on denormalized slot components (FeaturedCardGrid_*/RelatedContent_*)
# so they match the page-root treatment (topics -> topicsBlock). Kept narrow on purpose: the datasource
# extraction force-migrates every multi-ref field as json here, so listing more would over-convert fields
# the page root leaves as select or removes downstream (authors, eventlocation, ...).
#SIPHON_REF_BLOCKS_SLOTS_INCLUDE_FIELDS=topics
#SIPHON_PAGESTOEXCLUDE=*/data/*|*/403|*/404|*/pls search|*/search|*/Member Dashboard|*/Member Dashboard/*|*/LoginRedirect|*/Hospital Directory*|
#SIPHON_CACHECOMPONENTS=true
#SIPHON_CACHEMEDIAINDEX=true
#SIPHON_EXCLUDECOMPONENTS=PlainHTMLReusable|SiteAlert|CoveoSearchResources|CoveoGlobalSearchbox|OutOfDateModal|PageTabs|MvcForm|SitecoreFormWrapper
#SIPHON_CREATEREWRITES=true
#SIPHON_AVOIDINTERNALLINKS=true
#SIPHON_RICHTEXTMODE=html
#SIPHON_HTMLFIELDTYPE=html-tinymce
#SIPHON_REMOVEEMPTYFIELDS=true
#SIPHON_SKIPPAGEREFERENCES=false
#SIPHON_SKIPEXTRALINKFIELDS=false
#SIPHON_CHILDRENREFERENCESTYPES=PromoCard
# canvas stage: emit the datasource's Sitecore children as components in a "children" slot on the matching COMPONENT
#SIPHON_CHILDRENSLOTSTYPES=PhotoExhibit
#SIPHON_STARTPATH=/sitecore/content/CHA/PublicWebsite/Home
#SIPHON_contentRootPaths=/sitecore/content/CHA/PublicWebsite/Settings|/sitecore/login/sitecore/system/settings/feature/cha|/sitecore/content/CHA/PublicWebsite|/sitecore/system/Settings/Feature/Experience Accelerator/SiteMetadata/Enums/Twitter Card Types
#SIPHON_THREADS=30
#SIPHON_CACHEMODELS=true
#SIPHON_CACHEASSETS=true
#SIPHON_CACHEDIR=$(Root)/cache
#SIPHON_INPUTDIR=$(DataDir)/items
#SIPHON_MEDIAROOTDIR=$(Root)/data/media
# Only upload media referenced by content items; unreferenced media is excluded from the
# upload (verb-scoped flag for 'uniform-upload-assets' / stage 0100 -> AssetsUploader
