SkipDeployMedia=1

# Changed-files-only deploy/publish (see src/_incremental-deploy.ps1). Set to 0 to force
# full pushes; delete .p/.last-deployed.json to re-baseline (next run deploys fully).
#DeployIncremental=1

#SeedPushModeOverride=createOrUpdate

# Overrides the push mode of the NON-seed canvas pushes (4600-4740/4900-4910/5100),
# like SeedPushModeOverride does for seed. Empty = each stage's own default
# (locale=create; datatype/contenttype/patterns/nodes=createOrUpdate;
# category/component/composition/entry=mirror). Overriding a mirror kind to
# create/createOrUpdate stops remote deletions from propagating.
#ResultPushModeOverride=





